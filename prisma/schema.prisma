// 강사 Q&A 플랫폼 — PRD-instructor-qna.md §6 기준
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 학생. 이메일이 신원 키이며 token 이 개인 링크(/my/<token>)의 유일한 접근 수단.
model Student {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  token     String     @unique
  createdAt DateTime   @default(now())
  questions Question[]
}

/// 질문 유형. 강사가 관리하며 삭제 불가(참조 무결성) — 비활성화만 가능.
model Topic {
  id        String     @id @default(cuid())
  label     String
  hint      String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  questions Question[]
}

model Question {
  id       String  @id @default(cuid())
  /// Q-2026-0001-ABC · URL 식별자로도 사용
  publicNo String  @unique

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic   @relation(fields: [topicId], references: [id])

  /// 제출 시점 이름 스냅샷. Student.name 은 덮어써지므로 과거 이름 보존용.
  submitterName String

  /// 구조화 3필드 — 자유서술 한 칸을 강제 분해해 정보 부족을 막는다.
  context String
  tried   String
  problem String

  answer     String?
  answeredAt DateTime?

  /// 레이트리밋 판정용
  submitterIp String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([answeredAt])
  @@index([createdAt])
  @@index([studentId])
  @@index([topicId])
  @@index([submitterIp, createdAt])
}

/// 질문번호 순번. count() 대신 원자적 증가로 경합·재사용을 막는다.
model Counter {
  year  Int @id
  value Int @default(0)
}

/// 관리자 로그인 시도 기록. 무제한 비밀번호 대입을 막기 위한 것이다.
/// 서버리스에서는 인스턴스가 요청마다 바뀌어 메모리 카운터를 쓸 수 없다.
model LoginAttempt {
  id        String   @id @default(cuid())
  /// 헤더에서 IP를 못 얻으면 "unknown" 으로 한 바구니에 묶는다.
  ip        String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([createdAt])
}

model Settings {
  id                Int     @id @default(1)
  serviceName       String  @default("강사 질문방")
  /// 강사 알림 수신 주소. 쉼표로 다중 등록.
  notifyEmail       String?
  adminPasswordHash String?

  /// 최근 이메일 발송 실패 내용. 강사가 설정 화면에서 바로 확인할 수 있게 남긴다.
  /// 발송 실패는 사용자 화면에 드러내지 않는 설계라, 기록해두지 않으면 아무도 모른다.
  lastEmailError   String?
  lastEmailErrorAt DateTime?
  lastEmailOkAt    DateTime?
}
