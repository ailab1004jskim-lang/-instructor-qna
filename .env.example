# PostgreSQL 연결 문자열
# 서버리스(Vercel 등)에 배포할 경우 반드시 커넥션 풀러 엔드포인트를 사용할 것 (PRD §5)
DATABASE_URL="postgresql://user:password@localhost:5432/instructor_qna"

# 강사 최초 로그인 비밀번호. 로그인 후 /admin/settings 에서 변경하면 DB 해시가 우선한다.
ADMIN_PASSWORD="change-me"

# 세션 쿠키 서명용 랜덤 문자열
SESSION_SECRET="change-me-to-a-long-random-string"

# Resend. 비우면 이메일 발송을 건너뛴다(로컬 개발용).
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# 이메일 본문의 링크에 쓸 절대 URL. 비우면 요청 헤더에서 유추한다.
APP_BASE_URL=""
