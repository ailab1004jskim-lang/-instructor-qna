# 앱 실행용 PostgreSQL 연결 문자열.
# 서버리스(Vercel 등)에 배포하면 인스턴스마다 커넥션을 열어 풀이 고갈되므로
# 반드시 커넥션 풀러 엔드포인트를 쓸 것 (Neon 이면 호스트에 -pooler 가 붙은 주소).
DATABASE_URL="postgresql://user:password@localhost:5432/instructor_qna"

# 마이그레이션 전용 직결(direct) 연결. 풀러는 세션 상태를 보장하지 않아 스키마 변경에 부적합하다.
# 풀러를 쓰지 않는 환경(로컬 등)에서는 비워두면 DATABASE_URL 을 그대로 사용한다.
DIRECT_URL=""

# 강사 최초 로그인 비밀번호. 로그인 후 /admin/settings 에서 변경하면 DB 해시가 우선한다.
ADMIN_PASSWORD="change-me"

# 세션 쿠키 서명용 랜덤 문자열
SESSION_SECRET="change-me-to-a-long-random-string"

# Resend. 비우면 실제 발송 대신 터미널에 수신자·제목·링크를 출력한다(개발용).
RESEND_API_KEY=""
# 도메인을 인증하기 전에는 onboarding@resend.dev 를 쓸 수 있으나,
# 이 경우 Resend 계정 소유자 본인 주소로만 발송된다(학생에게는 가지 않음).
EMAIL_FROM="onboarding@resend.dev"

# 이메일 본문의 링크에 쓸 절대 URL. 비우면 요청 헤더에서 유추한다.
# 배포 후에는 실제 도메인을 넣을 것 (예: https://qna.example.com)
APP_BASE_URL=""
